<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="420.0" prefWidth="380.0" spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.viewController.LoginViewController">
    <children>
        <Label styleClass="titulo" text="Monedero Virtual" />
        <Label styleClass="subtitulo" text="Inicia sesión para continuar" />
        <Label text="Identificación" />
        <TextField fx:id="txtIdentificacion" maxWidth="240.0" onAction="#onIngresar" promptText="Ej: 1001" />
        <Label text="Contraseña" />
        <PasswordField fx:id="txtContrasena" maxWidth="240.0" onAction="#onIngresar" />
        <Button defaultButton="true" mnemonicParsing="false" onAction="#onIngresar" prefWidth="240.0" styleClass="boton-principal" text="Ingresar" />
        <Button mnemonicParsing="false" onAction="#onIrRegistro" prefWidth="240.0" text="Registrarme como cliente nuevo" />
        <Label styleClass="ayuda" text="Datos de prueba: 1001 / clave1 · 2002 / clave2 · 3003 / clave3" wrapText="true" />
    </children>
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
    </padding>
</VBox>
