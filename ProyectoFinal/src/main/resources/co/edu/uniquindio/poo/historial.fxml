<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.viewController.HistorialViewController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="barra-navegacion">
            <children>
                <Button mnemonicParsing="false" onAction="#onVolver" text="← Volver al panel" />
                <Region HBox.hgrow="ALWAYS" />
                <Label styleClass="marca" text="Historial" />
            </children>
            <padding>
                <Insets bottom="10.0" left="16.0" right="16.0" top="10.0" />
            </padding>
        </HBox>

        <VBox spacing="12.0" VBox.vgrow="ALWAYS">
            <children>
                <!-- Filtros: vacío = todos -->
                <FlowPane hgap="10.0" vgap="8.0">
                    <children>
                        <ComboBox fx:id="cmbFiltroTipo" prefWidth="160.0" promptText="Tipo: todos" />
                        <ComboBox fx:id="cmbFiltroCategoria" prefWidth="170.0" promptText="Categoría: todas" />
                        <DatePicker fx:id="dpDesde" prefWidth="140.0" promptText="Desde" />
                        <DatePicker fx:id="dpHasta" prefWidth="140.0" promptText="Hasta" />
                        <Button mnemonicParsing="false" onAction="#onFiltrar" styleClass="boton-principal" text="Filtrar" />
                        <Button mnemonicParsing="false" onAction="#onLimpiarFiltros" text="Limpiar filtros" />
                    </children>
                </FlowPane>

                <TableView fx:id="tblTransacciones" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="tbcId" prefWidth="80.0" text="Id" />
                        <TableColumn fx:id="tbcFecha" prefWidth="125.0" text="Fecha" />
                        <TableColumn fx:id="tbcTipo" prefWidth="110.0" text="Tipo" />
                        <TableColumn fx:id="tbcMonedero" prefWidth="80.0" text="Monedero" />
                        <TableColumn fx:id="tbcMonto" prefWidth="95.0" text="Monto" />
                        <TableColumn fx:id="tbcComision" prefWidth="85.0" text="Comisión" />
                        <TableColumn fx:id="tbcCategoria" prefWidth="120.0" text="Categoría" />
                        <TableColumn fx:id="tbcEstado" prefWidth="100.0" text="Estado" />
                        <TableColumn fx:id="tbcDescripcion" prefWidth="170.0" text="Descripción" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <HBox alignment="CENTER_LEFT" spacing="14.0">
                    <children>
                        <Label fx:id="lblResultados" />
                        <Label styleClass="leyenda-sospechosa" text="  Sospechosa  " />
                        <Label styleClass="leyenda-revertida" text="  Revertida  " />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#onRevertir" text="Revertir seleccionada" />
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
            </padding>
        </VBox>
    </children>
</VBox>
