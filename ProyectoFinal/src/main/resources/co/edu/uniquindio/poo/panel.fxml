<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="560.0" prefWidth="760.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.viewController.PanelViewController">
    <children>
        <!-- Barra de navegación -->
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="barra-navegacion">
            <children>
                <Label styleClass="marca" text="Monedero Virtual" />
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#onIrOperaciones" text="Operaciones" />
                <Button mnemonicParsing="false" onAction="#onIrHistorial" text="Historial" />
                <Button mnemonicParsing="false" onAction="#onIrPuntos" text="Puntos" />
                <Button mnemonicParsing="false" onAction="#onIrAvanzado" text="Avanzado" />
                <Button mnemonicParsing="false" onAction="#onCerrarSesion" text="Cerrar sesión" />
            </children>
            <padding>
                <Insets bottom="10.0" left="16.0" right="16.0" top="10.0" />
            </padding>
        </HBox>

        <VBox spacing="14.0" VBox.vgrow="ALWAYS">
            <children>
                <HBox alignment="BASELINE_LEFT" spacing="12.0">
                    <children>
                        <Label fx:id="lblBienvenida" styleClass="titulo" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblFecha" styleClass="ayuda" />
                    </children>
                </HBox>

                <!-- Resumen -->
                <HBox spacing="12.0">
                    <children>
                        <VBox styleClass="tarjeta" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="tarjeta-titulo" text="Saldo total" />
                                <Label fx:id="lblSaldoTotal" styleClass="tarjeta-valor" />
                            </children>
                        </VBox>
                        <VBox styleClass="tarjeta" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="tarjeta-titulo" text="Puntos" />
                                <Label fx:id="lblPuntos" styleClass="tarjeta-valor" />
                            </children>
                        </VBox>
                        <VBox styleClass="tarjeta" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="tarjeta-titulo" text="Rango" />
                                <Label fx:id="lblRango" styleClass="tarjeta-valor" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <Label styleClass="subtitulo" text="Mis monederos" />
                <TableView fx:id="tblMonederos" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="tbcId" prefWidth="100.0" text="Id" />
                        <TableColumn fx:id="tbcNombre" prefWidth="220.0" text="Nombre" />
                        <TableColumn fx:id="tbcTipo" prefWidth="180.0" text="Tipo" />
                        <TableColumn fx:id="tbcSaldo" prefWidth="180.0" text="Saldo" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <!-- Crear monedero -->
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label text="Nuevo monedero:" />
                        <TextField fx:id="txtNombreMonedero" promptText="Nombre" />
                        <ComboBox fx:id="cmbTipoMonedero" prefWidth="170.0" promptText="Tipo" />
                        <Button mnemonicParsing="false" onAction="#onCrearMonedero" styleClass="boton-principal" text="Crear monedero" />
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
            </padding>
        </VBox>
    </children>
</VBox>
