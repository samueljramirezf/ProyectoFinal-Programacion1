<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="640.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.viewController.PuntosViewController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="barra-navegacion">
            <children>
                <Button mnemonicParsing="false" onAction="#onVolver" text="← Volver al panel" />
                <Region HBox.hgrow="ALWAYS" />
                <Label styleClass="marca" text="Puntos y beneficios" />
            </children>
            <padding>
                <Insets bottom="10.0" left="16.0" right="16.0" top="10.0" />
            </padding>
        </HBox>

        <VBox spacing="14.0" VBox.vgrow="ALWAYS">
            <children>
                <!-- Resumen -->
                <HBox spacing="12.0">
                    <children>
                        <VBox styleClass="tarjeta" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="tarjeta-titulo" text="Puntos disponibles" />
                                <Label fx:id="lblDisponibles" styleClass="tarjeta-valor" />
                            </children>
                        </VBox>
                        <VBox styleClass="tarjeta" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="tarjeta-titulo" text="Puntos acumulados (definen el rango)" />
                                <Label fx:id="lblAcumulados" styleClass="tarjeta-valor" />
                            </children>
                        </VBox>
                        <VBox styleClass="tarjeta" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="tarjeta-titulo" text="Rango" />
                                <Label fx:id="lblRango" styleClass="tarjeta-valor" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <!-- Canjes -->
                <Label styleClass="subtitulo" text="Canjear puntos" />
                <HBox spacing="12.0">
                    <children>
                        <VBox spacing="8.0" styleClass="tarjeta" HBox.hgrow="ALWAYS">
                            <children>
                                <Label fx:id="lblDescuento100" minHeight="-Infinity" wrapText="true" />
                                <Region VBox.vgrow="ALWAYS" />
                                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onCanjearDescuento" styleClass="boton-principal" text="Canjear" />
                            </children>
                        </VBox>
                        <VBox spacing="8.0" styleClass="tarjeta" HBox.hgrow="ALWAYS">
                            <children>
                                <Label fx:id="lblRetiros500" minHeight="-Infinity" wrapText="true" />
                                <Region VBox.vgrow="ALWAYS" />
                                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onCanjearRetiros" styleClass="boton-principal" text="Canjear" />
                            </children>
                        </VBox>
                        <VBox spacing="8.0" styleClass="tarjeta" HBox.hgrow="ALWAYS">
                            <children>
                                <Label fx:id="lblBono1000" minHeight="-Infinity" wrapText="true" />
                                <ComboBox fx:id="cmbMonederoBono" maxWidth="Infinity" promptText="Monedero que recibe" />
                                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onCanjearBono" styleClass="boton-principal" text="Canjear" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <!-- Tablas -->
                <HBox spacing="12.0" VBox.vgrow="ALWAYS">
                    <children>
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="subtitulo" text="Beneficios vigentes" />
                                <TableView fx:id="tblBeneficios" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="tbcBeneficioId" prefWidth="70.0" text="Id" />
                                        <TableColumn fx:id="tbcBeneficioDescripcion" prefWidth="200.0" text="Beneficio" />
                                        <TableColumn fx:id="tbcBeneficioVence" prefWidth="100.0" text="Vence" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                    <placeholder>
                                        <Label text="No tienes beneficios vigentes" />
                                    </placeholder>
                                </TableView>
                            </children>
                        </VBox>
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="subtitulo" text="Historial de puntos" />
                                <TableView fx:id="tblMovimientos" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="tbcMovFecha" prefWidth="110.0" text="Fecha" />
                                        <TableColumn fx:id="tbcMovTipo" prefWidth="85.0" text="Tipo" />
                                        <TableColumn fx:id="tbcMovPuntos" prefWidth="55.0" text="Puntos" />
                                        <TableColumn fx:id="tbcMovDescripcion" prefWidth="180.0" text="Descripción" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                    <placeholder>
                                        <Label text="Aún no hay movimientos de puntos" />
                                    </placeholder>
                                </TableView>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
            </padding>
        </VBox>
    </children>
</VBox>
