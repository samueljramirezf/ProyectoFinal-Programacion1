<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="560.0" prefWidth="760.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.viewController.OperacionesViewController">
    <fx:define>
        <ToggleGroup fx:id="tgDestino" />
    </fx:define>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="barra-navegacion">
            <children>
                <Button mnemonicParsing="false" onAction="#onVolver" text="← Volver al panel" />
                <Region HBox.hgrow="ALWAYS" />
                <Label styleClass="marca" text="Operaciones" />
            </children>
            <padding>
                <Insets bottom="10.0" left="16.0" right="16.0" top="10.0" />
            </padding>
        </HBox>

        <VBox maxWidth="560.0" spacing="12.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label minWidth="150.0" text="Tipo de operación" />
                        <ComboBox fx:id="cmbTipo" onAction="#onTipoCambiado" prefWidth="320.0" promptText="Depósito, retiro o transferencia" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label fx:id="lblMonedero" minWidth="150.0" text="Monedero" />
                        <ComboBox fx:id="cmbMonedero" onAction="#onCampoCambiado" prefWidth="320.0" promptText="Elige un monedero" />
                    </children>
                </HBox>

                <!-- Solo para transferencias -->
                <VBox fx:id="boxTransferencia" spacing="10.0" styleClass="tarjeta">
                    <children>
                        <Label styleClass="tarjeta-titulo" text="Destino de la transferencia" />
                        <HBox spacing="16.0">
                            <children>
                                <RadioButton fx:id="rbPropio" mnemonicParsing="false" onAction="#onDestinoCambiado" selected="true" text="Entre mis monederos" toggleGroup="$tgDestino" />
                                <RadioButton fx:id="rbOtroCliente" mnemonicParsing="false" onAction="#onDestinoCambiado" text="A otro cliente" toggleGroup="$tgDestino" />
                            </children>
                        </HBox>
                        <HBox fx:id="boxOtroCliente" alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label minWidth="140.0" text="Identificación" />
                                <TextField fx:id="txtIdOtroCliente" onAction="#onBuscarCliente" promptText="Ej: 2002" />
                                <Button mnemonicParsing="false" onAction="#onBuscarCliente" text="Buscar" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label minWidth="140.0" text="Monedero destino" />
                                <ComboBox fx:id="cmbDestino" onAction="#onCampoCambiado" prefWidth="320.0" promptText="Elige el destino" />
                            </children>
                        </HBox>
                    </children>
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </VBox>

                <HBox fx:id="boxCategoria" alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label minWidth="150.0" text="Categoría" />
                        <ComboBox fx:id="cmbCategoria" prefWidth="320.0" promptText="¿En qué se gasta?" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label minWidth="150.0" text="Monto" />
                        <TextField fx:id="txtMonto" onKeyTyped="#onCampoCambiado" prefWidth="320.0" promptText="Ej: 250 o 250.50" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label minWidth="150.0" text="Descripción (opcional)" />
                        <TextField fx:id="txtDescripcion" prefWidth="320.0" />
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#onCalcularComision" text="Ver comisión" />
                        <Button defaultButton="true" mnemonicParsing="false" onAction="#onRealizarOperacion" styleClass="boton-principal" text="Realizar operación" />
                        <Label fx:id="lblComision" styleClass="comision" />
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
            </padding>
        </VBox>
    </children>
</VBox>
